diff --git a/src/main/scala/xiangshan/backend/fu/wrapper/VDot.scala b/src/main/scala/xiangshan/backend/fu/wrapper/VDot.scala
new file mode 100644
index 000000000..8a28cc102
--- /dev/null
+++ b/src/main/scala/xiangshan/backend/fu/wrapper/VDot.scala
@@ -0,0 +1,34 @@
+package xiangshan.backend.fu.wrapper
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config.Parameters
+import xiangshan.ExceptionNO.illegalInstr
+import xiangshan.backend.fu.FuConfig
+import xiangshan.backend.fu.vector.VecPipedFuncUnit
+
+/** v0.1 fixed-eight signed INT8 reduction. No generic destination MGU. */
+class VDot(cfg: FuConfig)(implicit p: Parameters) extends VecPipedFuncUnit(cfg) {
+  require(VLEN == 128 && cfg.destDataBits == 128)
+  require(latency == 2 && latdiff == 0)
+
+  val products = VecInit((0 until 8).map { i =>
+    val product = vs1(8*i+7, 8*i).asSInt * vs2(8*i+7, 8*i).asSInt
+    Mux(srcMask(i), product, 0.S(16.W))
+  })
+  val p1 = S1Reg(products)
+  val pairs = (0 until 4).map(i => p1(2*i) +& p1(2*i+1))
+  val halves = (0 until 2).map(i => pairs(2*i) +& pairs(2*i+1))
+  val sum = halves(0) +& halves(1) // 19 bits, including +131072
+  val result = S2Reg(Cat(0.U(96.W), sum.pad(32).asUInt))
+
+  // The compact type/VS legality is checked upstream; retain a local guard.
+  val illegal = outVecCtrl.vill || outVecCtrl.vsew =/= 0.U ||
+    outVecCtrl.vlmul =/= 0.U || outVstart =/= 0.U ||
+    (outVl =/= 0.U && (outVl < 8.U || outVl > 16.U))
+  io.out.bits.res.data := Mux(outVl === 0.U || illegal, outOldVd, result)
+  io.out.bits.ctrl.exceptionVec.get(illegalInstr) := illegal
+  // Keep vecWen/v0Wen for legal vl=0: the new physical destination needs oldVd.
+  // CSR updates and precise exceptions remain on the ordinary commit path.
+  io.out.valid := fixValidVec.last && !outCtrl.robIdx.needFlush(io.flush)
+}
diff --git a/src/main/scala/xiangshan/backend/rob/VdotTrapInst.scala b/src/main/scala/xiangshan/backend/rob/VdotTrapInst.scala
new file mode 100644
index 000000000..1ec83d273
--- /dev/null
+++ b/src/main/scala/xiangshan/backend/rob/VdotTrapInst.scala
@@ -0,0 +1,57 @@
+package xiangshan.backend.rob
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config.Parameters
+import xiangshan._
+import xiangshan.backend.decode.VdotInstructions
+
+/** Functional ROB-indexed storage, deliberately independent of DebugMem.
+  * Only the 16 variable encoding bits are stored. The ROB generation bit
+  * prevents a reused index from identifying a different dynamic instruction.
+  * Every allocation, including non-VDot, replaces the slot's classification.
+  * Squashed entries may remain in storage; only a live ROB-head exception can
+  * request a result, and allocation overwrites a slot before it is reused.
+  */
+class VdotTrapInstTable(implicit p: Parameters) extends XSModule {
+  val io = IO(new Bundle {
+    val alloc = Input(Vec(RenameWidth, Valid(new Bundle {
+      val robIdx = new RobPtr
+      val instr = UInt(32.W)
+    })))
+    val head = Input(new RobPtr)
+    val trap = Input(Bool())
+    val illegal = Input(Bool())
+    val interrupt = Input(Bool())
+    val out = Output(Valid(UInt(32.W)))
+  })
+  val isVdot = RegInit(VecInit(Seq.fill(RobSize)(false.B)))
+  val generation = Reg(Vec(RobSize, Bool()))
+  val fields = Reg(Vec(RobSize, UInt(16.W)))
+  for (a <- io.alloc) {
+    when(a.valid) {
+      val idx = a.bits.robIdx.value
+      isVdot(idx) := VdotInstructions.VDOT_VV === a.bits.instr
+      generation(idx) := a.bits.robIdx.flag
+      fields(idx) := Cat(a.bits.instr(25), a.bits.instr(24,20),
+                        a.bits.instr(19,15), a.bits.instr(11,7))
+    }
+  }
+  val f = fields(io.head.value)
+  val word = Cat(0.U(6.W), f(15), f(14,10), f(9,5), 0.U(3.W), f(4,0), "h0b".U(7.W))
+  val matched = isVdot(io.head.value) && generation(io.head.value) === io.head.flag
+  // Same one-cycle capture as Rob.io.exception; no writeback-order arbitration.
+  io.out.valid := RegNext(io.trap && io.illegal && !io.interrupt && matched, false.B)
+  io.out.bits := RegEnable(word, io.trap)
+}
+
+object VdotTrapInstSelect {
+  def apply(trap: Bool, interrupt: Bool, illegal: Bool,
+            vdot: ValidIO[UInt], legacy: ValidIO[UInt]): ValidIO[UInt] = {
+    val out = Wire(Valid(UInt(32.W)))
+    val useVdot = trap && !interrupt && illegal && vdot.valid
+    out.valid := Mux(useVdot, true.B, legacy.valid)
+    out.bits := Mux(useVdot, vdot.bits, legacy.bits)
+    out
+  }
+}
